# Local Postgres needs no sslmode. For any hosted database (Neon, Supabase, RDS)
# append ?sslmode=verify-full — the app no longer sets TLS options in code.
DATABASE_URL="postgresql://user:password@localhost:5432/movieshop"

# Get from better-auth docs
BETTER_AUTH_SECRET=YOURS_KEY_FROM_BETTER_AUTH
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Needed for seeding
TMDB_API_KEY=

# SMTP — required for verification and password-reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
